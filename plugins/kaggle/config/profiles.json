{
  "python-smoke": {
    "description": "Dependency-free end-to-end smoke test for the Kaggle bridge.",
    "capabilities": [
      "cpu"
    ],
    "internet": false,
    "steps": [
      {
        "argv": [
          "python",
          "-c",
          "import json, pathlib, sys; pathlib.Path('smoke-result.json').write_text(json.dumps({'ok': True, 'python': sys.version}), encoding='utf-8'); print('CHATGPT_PLUGINS_SMOKE_OK')"
        ],
        "cwd": "."
      }
    ],
    "artifact_globs": [
      "source/smoke-result.json"
    ]
  },
  "python-tests": {
    "description": "Run the project's Python tests without invoking a shell.",
    "capabilities": [
      "cpu"
    ],
    "internet": false,
    "steps": [
      {
        "argv": [
          "python",
          "-m",
          "pytest",
          "-q"
        ],
        "cwd": "."
      }
    ],
    "artifact_globs": []
  },
  "django-check": {
    "description": "Run Django system and migration drift checks.",
    "capabilities": [
      "cpu"
    ],
    "internet": false,
    "steps": [
      {
        "argv": [
          "python",
          "manage.py",
          "check"
        ],
        "cwd": "."
      },
      {
        "argv": [
          "python",
          "manage.py",
          "makemigrations",
          "--check",
          "--dry-run"
        ],
        "cwd": "."
      }
    ],
    "artifact_globs": []
  },
  "ml-train": {
    "description": "Run a repository-owned train.py entrypoint on a GPU account.",
    "capabilities": [
      "gpu"
    ],
    "internet": false,
    "steps": [
      {
        "argv": [
          "python",
          "train.py"
        ],
        "cwd": "."
      }
    ],
    "artifact_globs": [
      "source/**/*.json",
      "source/**/*.csv",
      "source/**/*.pt",
      "source/**/*.pth"
    ]
  }
}
