{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-kaggle-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "KaggleGatewayContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KAGGLE_GATEWAY",
        "class_name": "KaggleGatewayContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KaggleGatewayContainer"]
    }
  ]
}
